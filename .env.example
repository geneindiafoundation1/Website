# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# The site runs WITHOUT any of these — it falls back to the seed content in
# src/lib/seed.ts. Fill them in to enable the admin panel and real emails.
# ---------------------------------------------------------------------------

# Public site URL, used for sitemap + canonical tags
NEXT_PUBLIC_SITE_URL=https://geneindiafoundation.org

# Supabase — database, image storage, and admin login
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Newer projects issue a "publishable" key; older ones an "anon" key. Either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret server key — backups only. Project Settings → API → service_role.
# Never put this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Mail — contact form + donor thank-you emails.
# Prefer SMTP on the foundation mailbox so mail is sent as that address.
# Hostinger / cPanel typical values: smtp.hostinger.com, port 465, secure true.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@geneindiafoundation.org
SMTP_PASS=
EMAIL_FROM="GENE-INDIA Foundation <info@geneindiafoundation.org>"
# Where contact-form messages and donation alerts are delivered.
# Comma-separated if you ever want more than one recipient.
EMAIL_TO=info@geneindiafoundation.org

# Optional fallback if SMTP is not set (resend.com/api-keys).
# EMAIL_FROM must then be a verified Resend domain.
# RESEND_API_KEY=
